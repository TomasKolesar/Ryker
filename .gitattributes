# Normalize line endings for text files
* text=auto

# Unity text assets (YAML) — always stored with LF line endings
*.unity        text eol=lf
*.prefab       text eol=lf
*.asset        text eol=lf
*.mat          text eol=lf
*.anim         text eol=lf
*.controller   text eol=lf
*.meta         text eol=lf

# Binary files — never diff or modify
*.png   binary
*.jpg   binary
*.jpeg  binary
*.psd   binary
*.tga   binary
*.ttf   binary
*.otf   binary
*.wav   binary
*.mp3   binary
*.ogg   binary
*.fbx   binary
*.pdf   binary
*.db    binary
